rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HeartInsight public analytics: allow read access to aggregated health metrics
    match /analytics/{document=**} {
      allow read: if true;
      allow write: if request.auth != null; // Only authenticated admins/pipeline service accounts can write
    }
    
    // Cohorts & benchmarks data
    match /benchmarks/{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Deny all other collections by default for HIPAA/privacy compliance
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
